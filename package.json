{
  "name": "karina-reyes-ecommerce",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter inttimo dev",
    "dev:inttimo": "pnpm --filter inttimo dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "db:generate": "pnpm --filter @inttimo/database db:generate",
    "db:migrate": "pnpm --filter @inttimo/database db:migrate",
    "presale:upsert": "pnpm --filter inttimo presale:upsert",
    "presale:export": "pnpm --silent --filter inttimo presale:export",
    "presale:reconcile": "pnpm --filter inttimo presale:reconcile",
    "store:seed": "pnpm --filter inttimo store:seed",
    "admin": "pnpm --filter inttimo admin",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "dev:seed": "pnpm --filter inttimo presale:upsert --file=docs/preventa/dev/campaign.dev.json --terms=docs/preventa/dev/terminos.dev.md"
  }
}
