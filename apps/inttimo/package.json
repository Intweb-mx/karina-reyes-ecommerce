{
  "name": "inttimo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "pnpm --filter @inttimo/database db:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "presale:upsert": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/presale-upsert.ts",
    "presale:export": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/presale-export.ts",
    "presale:reconcile": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/presale-reconcile.ts",
    "store:reconcile": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/store-reconcile.ts",
    "store:seed": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/store-seed.ts",
    "admin": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/admin.ts"
  },
  "dependencies": {
    "@inttimo/database": "workspace:*",
    "@inttimo/shared-utils": "workspace:*",
    "@inttimo/storage": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inttimo/tsconfig": "workspace:*",
    "@next/env": "16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
