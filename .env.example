# Solo nombres de variables y valores de ejemplo NO secretos.
# Copia a .env para desarrollo local. Nunca subas .env al repositorio.

# ---------- Web inttimo (apps/inttimo) ----------
# URL pública; se usa para las URLs de regreso de Stripe Checkout. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
ANALYTICS_ID=

# ---------- Base de datos (packages/database) ----------
# Local: `pnpm db:local` levanta PostgreSQL (PGlite) en el puerto 54332.
# (54322 lo usan Supabase local y el repo de Karina Reyes: no reutilizarlo.)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54332/postgres
# Con PGlite local usa 1. En producción 3–10. Con pooler tipo PgBouncer usa DATABASE_PREPARE=false.
DATABASE_MAX_CONNECTIONS=1
DATABASE_PREPARE=true
DATABASE_CONNECT_TIMEOUT=10
# Opcional: conexión directa (sin pooler) para las migraciones del deploy de producción.
DATABASE_URL_UNPOOLED=

# ---------- Stripe (preventa) ----------
# Llave secreta (sk_test_… en desarrollo/preview, sk_live_… solo en producción). Nunca en el navegador.
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint /api/webhooks/stripe (whsec_…). Local: lo imprime `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Opcional: correo interno que recibe aviso de cada reserva pagada.
PRESALE_NOTIFY_EMAIL=

# ---------- Correo transaccional ----------
# resend (producción) | log (consola, desarrollo) | file (MAIL_OUTBOX_FILE, pruebas)
MAIL_DRIVER=
MAIL_FROM=
RESEND_API_KEY=
MAIL_OUTBOX_FILE=

# ---------- Almacenamiento de archivos ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=

# ---------- Tienda completa (Fase 2) — NO usar hasta aprobación explícita ----------
SKYDROPX_API_KEY=
