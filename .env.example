# Solo nombres de variables y valores de ejemplo NO secretos.
# Copia a .env para desarrollo local. Nunca subas .env al repositorio.
# Los valores locales de abajo son los públicos de `supabase start` (no son secretos).

# ---------- Sitio (apps/inttimo) ----------
# URL pública; se usa para las URLs de regreso de Stripe Checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
ANALYTICS_ID=

# ---------- Supabase ----------
# Local: `pnpm supabase:start` (puertos 55321–55329). Producción: Settings → API del proyecto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Llave secreta (service role). SOLO para la CLI `pnpm admin`; nunca en el navegador ni en Vercel.
SUPABASE_SECRET_KEY=

# ---------- Base de datos (Supabase Postgres) ----------
# Producción: pooler en modo transacción (puerto 6543) + DATABASE_PREPARE=false.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_PREPARE=true
# Local 5. Producción (serverless) 1–3 por instancia: el pooler multiplexa.
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=10
# Conexión directa o pooler de sesión (puerto 5432) para migraciones. Si falta, usa DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ---------- Stripe (preventa) ----------
# sk_test_… en desarrollo/preview, sk_live_… solo en producción. Nunca en el navegador.
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint /api/webhooks/stripe (whsec_…). Local: lo imprime `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Opcional: correo interno que recibe aviso de cada reserva pagada.
PRESALE_NOTIFY_EMAIL=

# ---------- Correo transaccional ----------
# resend (producción) | log (consola, desarrollo) | file (MAIL_OUTBOX_FILE, pruebas)
MAIL_DRIVER=log
MAIL_FROM=
RESEND_API_KEY=
MAIL_OUTBOX_FILE=

# ---------- Almacenamiento de archivos (aún sin uso) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=

# ---------- Envíos (preventa) ----------
# SkyDropX Pro (cotización de envío de la preventa y guías). Configuración → Conexiones → API.
# Sin client id/secret el envío a domicilio no se ofrece (solo recolección).
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# sandbox (por defecto) | production
SKYDROPX_ENV=sandbox

# Tienda inttimo (Fase 2): ver docs/store/BACKEND-REQUEST.md
# Oculta en producción salvo "1". En desarrollo siempre visible.
NEXT_PUBLIC_STORE_ENABLED=
# "mock" (por defecto, datos de ejemplo) o "http" (endpoints /api/tienda/* del backend).
NEXT_PUBLIC_STORE_API=mock
