# Solo nombres de variables y valores de ejemplo NO secretos.
# Copia a .env para desarrollo local. Nunca subas .env al repositorio.
#
# Este repo no se toca hasta que la web personal de Karina Reyes
# (repo karina-reyes-ecosyste) esté aprobada. Ver CLAUDE.md.

# ---------- Web inttimo (apps/inttimo) ----------
NEXT_PUBLIC_SITE_URL=
ANALYTICS_ID=

# ---------- Base de datos (cuando exista packages/database propio) ----------
DATABASE_URL=

# ---------- Correo transaccional ----------
# resend (producción) | log (consola, desarrollo) | file (MAIL_OUTBOX_FILE, pruebas)
MAIL_DRIVER=
MAIL_FROM=
RESEND_API_KEY=
MAIL_OUTBOX_FILE=

# ---------- Almacenamiento de archivos ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=

# ---------- Pagos y envíos — NO usar hasta aprobación explícita de Fase 2 ----------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
SKYDROPX_API_KEY=
